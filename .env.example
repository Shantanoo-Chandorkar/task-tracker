NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, full RLS bypass -- Supabase Settings -> API Keys -> "Secret key" (not the
# legacy service_role key). Used by lib/supabase/admin.js for trusted system jobs only.
SUPABASE_SECRET_KEY=

# Shared secret required in the Authorization: Bearer header for the recurrence cron.
CRON_SECRET=

# App origin used to build password-reset redirect links -- never derived from request
# headers (Host/Referer are attacker-controlled). Local dev: http://localhost:3000
SITE_URL=

# Brevo SMTP credentials (Bucket 3: password-reset email). Server-only.
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM=

# Cloudflare Turnstile for the "Try as guest" button. The site key is public by design; leave BOTH empty to run
# without the security check (the guest session then relies on the per-IP limit alone). The secret is server-only,
# and Supabase's own captcha setting must stay OFF: it would also demand a token on every normal login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
