{
    "name": "task-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "perf:analyze": "cross-env ANALYZE=true next build --webpack",
        "perf:lighthouse:local": "lighthouse http://localhost:3000 --preset=perf --form-factor=mobile --screenEmulation.mobile --output=html --output=json --output-path=./perf-reports/lighthouse-local",
        "perf:lighthouse:prod": "lighthouse https://task-tracker-ashy-one.vercel.app --preset=perf --form-factor=mobile --screenEmulation.mobile --output=html --output=json --output-path=./perf-reports/lighthouse-prod"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.116.0",
        "@tanstack/react-query": "^5.99.0",
        "@tanstack/react-query-devtools": "^5.99.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cn": "^0.2.6",
        "date-fns": "^4.1.0",
        "lucide-react": "^1.8.0",
        "next": "^16.3.4",
        "prettier": "^3.8.3",
        "radix-ui": "^1.4.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "rrule": "^2.8.1",
        "shadcn": "^4.21.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "^16.3.5",
        "@tailwindcss/postcss": "^4",
        "@testing-library/react": "^16.3.2",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "1.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.4",
        "jsdom": "^29.0.2",
        "lighthouse": "^12.8.2",
        "tailwindcss": "^4",
        "vitest": "^5.0.0"
    }
}
