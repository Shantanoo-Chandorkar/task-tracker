{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@/modules/*": ["./modules/*"]
        }
    },
    "include": ["modules/**/*.js", "global.d.ts"],
    "exclude": ["node_modules", "modules/**/*.test.js", "modules/**/test-support/**"]
}
