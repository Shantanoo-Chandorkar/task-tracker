# Copy to .env.test (git-ignored) and fill in with your dev Supabase project's values.
# Playwright's test users are created/deleted via the admin API against this project -
# use a project you're fine with throwaway e2e-*@example.com accounts and data in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, full RLS bypass -- same key as .env.local's SUPABASE_SECRET_KEY. Used only
# to create/delete pre-confirmed throwaway test users, never sent to the browser.
SUPABASE_SECRET_KEY=

# Origin the app under test is running at - a dedicated test-only port, never your real
# `npm run dev` on 3000. Defaults to http://localhost:3001 if unset.
PLAYWRIGHT_BASE_URL=

# Used by the app itself to build confirmation/reset links (actions/auth-actions.js) - keep
# this matching PLAYWRIGHT_BASE_URL above so a clicked email link lands back in the test run.
SITE_URL=http://localhost:3001

# Redirects the app's real Brevo SMTP send to the local Mailpit instance Playwright starts
# (playwright.config.js), so signup-confirmation/password-reset emails are testable without
# sending anything real. Any process.env key set here - even blank - stops Next.js loading
# .env.local's real Brevo credentials instead (Next never overrides an already-set var).
# Ports 2525/2526, not Mailpit's own defaults (1025/8025) - those collide with other local dev
# tools that also run Mailpit (e.g. WP Engine's Local) on this machine. See docs/e2e-test-quality.md.
BREVO_SMTP_HOST=127.0.0.1
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM=Task Tracker Test <test@example.com>

# Base URL of Mailpit's REST API (e2e/fixtures/mailpit.js). Matches playwright.config.js's
# default; only needed here if you changed that port.
MAILPIT_API_URL=http://127.0.0.1:2526

# Blank, not absent: .env.local has a real Turnstile site key for local dev, and an unset var
# here would let Next.js fall through to that real key - which permanently disables the guest
# button in tests (no way to solve Cloudflare's captcha headlessly). Same shadowing rule as the
# BREVO_SMTP_* vars above - any key present here, even blank, wins over .env.local's real one.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
